{
  "name": "libby-downloader",
  "version": "1.2.0",
  "description": "CLI tool for managing audiobooks downloaded from Libby via Chrome extension",
  "main": "dist/index.js",
  "bin": {
    "libby": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:extension",
    "build:cli": "tsc && tsc-esm-fix --target='dist'",
    "build:extension": "node scripts/build-extension.mjs",
    "build:extension:watch": "vite build --watch",
    "dev": "tsx src/cli.ts",
    "dev:extension": "vite build --watch",
    "start": "node dist/cli.js",
    "watch": "tsc --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "check-all": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "husky",
    "extension:validate": "node --test scripts/validate-extension.test.cjs && node scripts/validate-extension.cjs",
    "lint:claude": "claudelint check-all",
    "lint:claude:fix": "claudelint format --fix",
    "fixtures": "bash scripts/generate-fixtures.sh",
    "fixtures:clean": "bash scripts/generate-fixtures.sh --clean",
    "test:cli": "bash scripts/test-cli.sh",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major"
  },
  "keywords": [
    "libby",
    "audiobook",
    "downloader",
    "overdrive"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "fluent-ffmpeg": "^2.1.3",
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "node-id3": "^0.2.9",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.1.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/chrome": "^0.2.2",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.28",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.53.0",
    "acorn": "^8.16.0",
    "claude-code-lint": "^0.7.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "ink-testing-library": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "release-it": "^20.2.1",
    "ts-jest": "^29.4.12",
    "tsc-esm-fix": "^3.1.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion@<2": "1.1.18",
    "brace-expansion@>=2 <3": "2.1.4",
    "brace-expansion@>=3": "5.0.9",
    "fast-uri": "3.1.5",
    "ip-address": "10.5.0",
    "js-yaml@<4": "3.15.1",
    "js-yaml@>=4": "4.3.1",
    "nanoid": "3.3.18",
    "node-forge": "1.4.0",
    "picomatch@<3": "2.3.2",
    "picomatch@>=4": "4.0.5",
    "postcss": "8.5.26",
    "shell-quote": "1.9.0",
    "undici": "7.29.0",
    "ws": "8.21.3"
  }
}
